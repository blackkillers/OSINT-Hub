# =============================================================================
# OSINT-HUB ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust default values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_ENV=production
APP_NAME=OSINT-Hub
LOG_LEVEL=INFO
SECRET_KEY=generate_a_super_secret_key_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Zero Trust Network & Security
# Bind to 127.0.0.1 for local/Tailscale reverse proxy deployment.
# -----------------------------------------------------------------------------
HOST_BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_USER=osint_admin
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password_123!
POSTGRES_DB=osint_hub_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://osint_admin:change_this_to_a_secure_postgres_password_123!@postgres:5432/osint_hub_db

# -----------------------------------------------------------------------------
# Redis & Celery Message Broker
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_this_to_a_secure_redis_password_123!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:change_this_to_a_secure_redis_password_123!@redis:6379/0
CELERY_BROKER_URL=redis://:change_this_to_a_secure_redis_password_123!@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change_this_to_a_secure_redis_password_123!@redis:6379/1

# -----------------------------------------------------------------------------
# Tor SOCKS5 Proxy Settings
# Used exclusively by Celery workers for Onion/Darkweb searches
# -----------------------------------------------------------------------------
TOR_SOCKS_PROXY=socks5://tor:9050

# -----------------------------------------------------------------------------
# Local AI Engine (Ollama)
# Model suggested: qwen2.5:7b or llama3.1:8b
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# OSINT API Credentials (Optional - Modules will fallback to CLI/Scraping)
# -----------------------------------------------------------------------------
# GeoINT / IoT Engines
SHODAN_API_KEY=your_shodan_api_key_here
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# Social / Phone / Leaks
HIBP_API_KEY=your_haveibeenpwned_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# -----------------------------------------------------------------------------
# Data Retention Policy (Days)
# -----------------------------------------------------------------------------
DATA_RETENTION_DAYS=7
